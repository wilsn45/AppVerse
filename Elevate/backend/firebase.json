{
  "functions": [
    {
      "source": "user",
      "codebase": "user"
    },
    {
      "source": "admin",
      "codebase": "admin",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/firebase.storage.rules"
  }
}
