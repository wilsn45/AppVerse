rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "l8SqZz2AOYfECNnlTnae0PhpjYI2";
    }

    match /curio/feed/{curioId}/{fileName} {

      // Curio feed images must be readable by the consumer app.
      allow read: if true;

      allow create, update:
        if isAdmin()
        && request.resource.size <= 500 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete:
        if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
