import AsyncStorage from '@react-native-async-storage/async-storage';

export class ContentHandler {
  static STORAGE_KEY = 'contentMap'; // Key for persistent storage

  // Method to save the title against the id in a map
  static async saveContent(id, title) {
    try {
      // Retrieve the current map from storage
      const contentMapString = await AsyncStorage.getItem(this.STORAGE_KEY);
      const contentMap = contentMapString ? JSON.parse(contentMapString) : {};

      // Add/Update the title for the given id
      contentMap[id] = title;

      // Store the updated map back to persistent storage
      await AsyncStorage.setItem(this.STORAGE_KEY, JSON.stringify(contentMap));
    } catch (error) {
      console.error('Error saving content to storage', error);
    }
  }
}
